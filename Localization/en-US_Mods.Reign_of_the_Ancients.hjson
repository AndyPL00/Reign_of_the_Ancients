		DisplayName: Spellblade Helmet
		Tooltip:
			'''
			{0}% increased melee and magic damage
			Increases maximum mana by {1}
			'''
		SetBonus:
			'''
			Spellweave: melee hits build an arcane charge
			After {0} hits, your next magic attack costs no mana and deals {1}% more damage
			Magic hits grant {2}% melee speed for {3} seconds
			'''
	}

	SpellbladeBreastplate: {
		DisplayName: Spellblade Breastplate
		Tooltip: "{0}% increased melee and magic critical strike chance"
	}

