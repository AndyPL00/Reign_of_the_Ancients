Items: {
	ElvenGreatsword: {
		DisplayName: Elven Greatsword
		Tooltip:
			'''
			Right click to swing out a magic slash that costs mana
			The slash scales with both melee and magic damage
			'''
	}

	SealedTome: {
		DisplayName: Sealed Tome
		Tooltip:
			'''
			Summons Volodar
			Only works in the throne room of the Mystical Library
			'''
	}

	ElvenEssence: {
		DisplayName: Elven Essence
		Tooltip: Dropped by the elves of the Mystical Library
	}

	VolodarsBow: {
		DisplayName: Volodar's Bow
		Tooltip: Every third shot fires an arcane arrow that splits into homing shards
	}

	VolodarsGrimoire: {
		DisplayName: Volodar's Grimoire
		Tooltip: Casts an arcane orb that explodes into homing shards
	}

	SpectralSigil: {
		DisplayName: Spectral Sigil
		Tooltip: Firing a ranged weapon summons a spectral archer that shoots the nearest enemy
	}

	VolodarBag: {
		DisplayName: Treasure Bag (Volodar)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}
}

